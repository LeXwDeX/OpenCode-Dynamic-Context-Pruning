{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/LeXwDeX/opencode-dynamic-context-pruning/master/dcp.schema.json",
    "title": "DCP Plugin Configuration",
    "description": "Semantic pruning policy for OpenCode native compaction",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON Schema reference for editor autocomplete"
        },
        "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable DCP"
        },
        "autoUpdate": {
            "type": "boolean",
            "default": true,
            "description": "Show a non-destructive notification when a newer package is available"
        },
        "debug": {
            "type": "boolean",
            "default": false,
            "description": "Enable debug logging"
        },
        "commands": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Register /dcp summarize"
                }
            },
            "default": { "enabled": true }
        },
        "experimental": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "customPrompts": {
                    "type": "boolean",
                    "default": false,
                    "description": "Load a compaction.md override from a dcp-prompts/overrides directory"
                }
            },
            "default": { "customPrompts": false }
        },
        "summarize": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "failureCooldownMs": {
                    "type": "number",
                    "minimum": 0,
                    "default": 30000,
                    "description": "Delay before retrying native summarize after a failure"
                }
            },
            "default": { "failureCooldownMs": 30000 }
        },
        "autoPrune": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Heuristically trigger native compaction between turns on topic drift, message volume or long idle gaps"
                },
                "minMessages": {
                    "type": "number",
                    "minimum": 1,
                    "default": 8,
                    "description": "Minimum user messages in the session before any auto-prune signal is considered"
                },
                "volumeThreshold": {
                    "type": "number",
                    "minimum": 2,
                    "default": 30,
                    "description": "User messages since the last prune that trigger compaction by volume"
                },
                "driftThreshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.18,
                    "description": "Jaccard similarity below which consecutive user messages count as a topic change"
                },
                "idleGapMs": {
                    "type": "number",
                    "minimum": 0,
                    "default": 1800000,
                    "description": "Gap between user messages that counts as resuming after a long break"
                },
                "cooldownMs": {
                    "type": "number",
                    "minimum": 0,
                    "default": 300000,
                    "description": "Minimum interval between two automatic prunes of the same session"
                }
            },
            "default": {
                "enabled": true,
                "minMessages": 8,
                "volumeThreshold": 30,
                "driftThreshold": 0.18,
                "idleGapMs": 1800000,
                "cooldownMs": 300000
            }
        },
        "tool": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Register the model-invokable dcp_prune tool with heuristic usage guidance"
                }
            },
            "default": { "enabled": true }
        }
    }
}
